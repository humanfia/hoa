import Mathlib.Tactic
import Ipho2026Gpt56solBlind.Shared.ISQDimensions
import Ipho2026Gpt56solBlind.Shared.FiniteObservations
import Physlib.Units.SIUnitChoices
import Physlib.Units.WithDim.Basic

/-!
# Figure 17 apparatus and Part A gas model

This module records the answer-independent geometry, preparation data,
confined-air inventory laws, and observation provenance for the Figure 17
apparatus.  Empirical observations are inputs to named runs; they are never
generated by the governing equations.
-/

namespace Ipho2026Gpt56solBlind.Shared.Figure17Apparatus

open Ipho2026Gpt56solBlind.Shared.ISQDimensions
open Ipho2026Gpt56solBlind.Shared.FiniteObservations

/-! ## Source-unit conversions -/

/-- Convert a source value in millimetres to a coherent-SI length. -/
noncomputable def lengthInMillimetres (x : ℝ) : Length :=
  quantityInSI SIUnitChoices.SI (⟨x / 1000⟩ : Length)

/-- Convert a source value in centimetres to a coherent-SI length. -/
noncomputable def lengthInCentimetres (x : ℝ) : Length :=
  quantityInSI SIUnitChoices.SI (⟨x / 100⟩ : Length)

/-- Interpret a source value in kilograms per cubic metre in coherent SI. -/
noncomputable def massDensityInKilogramsPerCubicMetre (x : ℝ) : MassDensity :=
  quantityInSI SIUnitChoices.SI (⟨x⟩ : MassDensity)

/-- Convert a source value in grams per mole to a coherent-SI molar mass. -/
noncomputable def molarMassInGramsPerMole (x : ℝ) : MolarMass :=
  quantityInSI SIUnitChoices.SI (⟨x / 1000⟩ : MolarMass)

/-- Interpret an amount-to-count factor supplied per mole in coherent SI. -/
noncomputable def inverseAmountInPerMole (x : ℝ) : InverseAmount :=
  quantityInSI SIUnitChoices.SI (⟨x⟩ : InverseAmount)

/-- Interpret an absolute temperature supplied in kelvin in coherent SI. -/
noncomputable def temperatureInKelvin (x : ℝ) : Temperature :=
  quantityInSI SIUnitChoices.SI (⟨x⟩ : Temperature)

/-- Interpret a molar gas constant supplied in joules per mole-kelvin in coherent SI. -/
noncomputable def molarGasConstantInJoulesPerMoleKelvin (x : ℝ) : MolarGasConstant :=
  quantityInSI SIUnitChoices.SI (⟨x⟩ : MolarGasConstant)

/-- A macroscopic molecule count, carried as a dimensionless real quantity. -/
abbrev MoleculeCount := Quantity (1 : Dimension ISQDimensionBase)

/-! ## Independent Figure 17 measurements -/

/-- Absolute coherent-SI tolerance for a measured length. -/
def WithinLengthTolerance (measured centre tolerance : Length) : Prop :=
  0 ≤ coordinateInSI SIUnitChoices.SI tolerance ∧
    |coordinateInSI SIUnitChoices.SI measured -
        coordinateInSI SIUnitChoices.SI centre| ≤
      coordinateInSI SIUnitChoices.SI tolerance

/-- The four independently measured Figure 17 cross-section lengths. -/
structure Figure17Measurements where
  /-- Clear inside diameter of the inner cylinder IC. -/
  innerCylinderInsideDiameter : Length
  /-- Outside diameter of the outer cylinder OC. -/
  outerCylinderOutsideDiameter : Length
  /-- Independently measured wall thickness of IC. -/
  innerCylinderWallThickness : Length
  /-- Independently measured wall thickness of OC. -/
  outerCylinderWallThickness : Length

/-- Source tolerances, positivity, and strict radial nesting for Figure 17. -/
def SatisfiesFigure17Geometry (measurements : Figure17Measurements) : Prop :=
  WithinLengthTolerance measurements.outerCylinderOutsideDiameter
      (lengthInMillimetres 74.8) (lengthInMillimetres 0.1) ∧
    WithinLengthTolerance measurements.innerCylinderInsideDiameter
      (lengthInMillimetres 33.7) (lengthInMillimetres 0.1) ∧
    WithinLengthTolerance measurements.innerCylinderWallThickness
      (lengthInMillimetres 3.4) (lengthInMillimetres 0.1) ∧
    WithinLengthTolerance measurements.outerCylinderWallThickness
      (lengthInMillimetres 3.4) (lengthInMillimetres 0.1) ∧
    0 < coordinateInSI SIUnitChoices.SI measurements.innerCylinderInsideDiameter ∧
    0 < coordinateInSI SIUnitChoices.SI measurements.outerCylinderOutsideDiameter ∧
    0 < coordinateInSI SIUnitChoices.SI measurements.innerCylinderWallThickness ∧
    0 < coordinateInSI SIUnitChoices.SI measurements.outerCylinderWallThickness ∧
    coordinateInSI SIUnitChoices.SI measurements.innerCylinderInsideDiameter / 2 +
        coordinateInSI SIUnitChoices.SI measurements.innerCylinderWallThickness <
      coordinateInSI SIUnitChoices.SI measurements.outerCylinderOutsideDiameter / 2 -
        coordinateInSI SIUnitChoices.SI measurements.outerCylinderWallThickness

/-- Clear cross-sectional area inside IC, using its measured inside diameter directly. -/
noncomputable def innerClearCrossSectionArea
    (measurements : Figure17Measurements) : Area :=
  ⟨Real.pi *
    (coordinateInSI SIUnitChoices.SI measurements.innerCylinderInsideDiameter / 2) ^ 2⟩

/-- Clear annular OC area outside the wall of IC and inside the wall of OC. -/
noncomputable def outerClearCrossSectionArea
    (measurements : Figure17Measurements) : Area :=
  ⟨Real.pi *
      (coordinateInSI SIUnitChoices.SI measurements.outerCylinderOutsideDiameter / 2 -
        coordinateInSI SIUnitChoices.SI measurements.outerCylinderWallThickness) ^ 2 -
    Real.pi *
      (coordinateInSI SIUnitChoices.SI measurements.innerCylinderInsideDiameter / 2 +
        coordinateInSI SIUnitChoices.SI measurements.innerCylinderWallThickness) ^ 2⟩

/-- Both geometrically available cross-sectional areas are strictly positive. -/
theorem clearCrossSectionAreas_positive (measurements : Figure17Measurements)
    (hGeometry : SatisfiesFigure17Geometry measurements) :
    0 < coordinateInSI SIUnitChoices.SI
        (innerClearCrossSectionArea measurements) ∧
      0 < coordinateInSI SIUnitChoices.SI
        (outerClearCrossSectionArea measurements) := by
  rcases hGeometry with
    ⟨_, _, _, _, hInnerDiameter, _, hInnerWall, _, hNesting⟩
  let rInner : ℝ :=
    coordinateInSI SIUnitChoices.SI measurements.innerCylinderInsideDiameter / 2 +
      coordinateInSI SIUnitChoices.SI measurements.innerCylinderWallThickness
  let rOuter : ℝ :=
    coordinateInSI SIUnitChoices.SI measurements.outerCylinderOutsideDiameter / 2 -
      coordinateInSI SIUnitChoices.SI measurements.outerCylinderWallThickness
  have hInnerClearRadius :
      0 < coordinateInSI SIUnitChoices.SI measurements.innerCylinderInsideDiameter / 2 :=
    div_pos hInnerDiameter (by norm_num)
  have hInnerRadius : 0 < rInner := by
    dsimp [rInner]
    positivity
  have hNesting' : rInner < rOuter := by
    simpa [rInner, rOuter] using hNesting
  have hOuterRadius : 0 < rOuter := lt_trans hInnerRadius hNesting'
  have hSquares : rInner ^ 2 < rOuter ^ 2 := by
    nlinarith
  have hScaledSquares : Real.pi * rInner ^ 2 < Real.pi * rOuter ^ 2 :=
    mul_lt_mul_of_pos_left hSquares Real.pi_pos
  constructor
  · simp only [coordinateInSI_self, innerClearCrossSectionArea]
    simpa only [coordinateInSI_self] using
      mul_pos Real.pi_pos (pow_pos hInnerClearRadius 2)
  · simp only [coordinateInSI_self, outerClearCrossSectionArea]
    apply sub_pos.mpr
    simpa only [rInner, rOuter, coordinateInSI_self] using hScaledSquares

/-! ## Fixed Part A column and correction idealization -/

/-- Independent hose-internal and sensor-displacement correction volumes. -/
structure VolumeCorrectionModel where
  /-- Internal volume of the connecting hose. -/
  hoseInternalVolume : Volume
  /-- Volume displaced by the temperature sensor inside IC. -/
  sensorDisplacedVolume : Volume

/-- The stated idealization that the two nonnegative corrections cancel exactly. -/
def UsesHoseSensorVolumeIdealization (corrections : VolumeCorrectionModel) : Prop :=
  0 ≤ coordinateInSI SIUnitChoices.SI corrections.hoseInternalVolume ∧
    0 ≤ coordinateInSI SIUnitChoices.SI corrections.sensorDisplacedVolume ∧
    corrections.hoseInternalVolume = corrections.sensorDisplacedVolume ∧
    coordinateInSI SIUnitChoices.SI
      (corrections.hoseInternalVolume - corrections.sensorDisplacedVolume) = 0

/-- Figure 17 geometry, the distinct heights `H` and `h`, and correction data. -/
structure ApparatusData where
  /-- Independent cross-section measurements. -/
  measurements : Figure17Measurements
  /-- Measured liquid-free air-column height `H` used in the isochoric run. -/
  airColumnHeight : Length
  /-- Introduced-liquid preparation height `h`, distinct from `H`. -/
  introducedLiquidHeight : Length
  /-- Hose and sensor volume corrections. -/
  volumeCorrections : VolumeCorrectionModel

/-- Figure 17 apparatus prepared according to the Part A source conditions. -/
def PreparedPartAApparatus (apparatus : ApparatusData) : Prop :=
  SatisfiesFigure17Geometry apparatus.measurements ∧
    0 < coordinateInSI SIUnitChoices.SI apparatus.airColumnHeight ∧
    apparatus.introducedLiquidHeight = lengthInCentimetres 4.5 ∧
    UsesHoseSensorVolumeIdealization apparatus.volumeCorrections

/-- Effective confined-air volume under the declared cancellation idealization. -/
noncomputable def confinedAirVolume (apparatus : ApparatusData) : Volume :=
  ⟨coordinateInSI SIUnitChoices.SI
      (innerClearCrossSectionArea apparatus.measurements) *
    coordinateInSI SIUnitChoices.SI apparatus.airColumnHeight⟩

/-- The effective confined-air volume of a prepared apparatus is positive. -/
theorem confinedAirVolume_positive (apparatus : ApparatusData)
    (hPrepared : PreparedPartAApparatus apparatus) :
    0 < coordinateInSI SIUnitChoices.SI (confinedAirVolume apparatus) := by
  rcases hPrepared with ⟨hGeometry, hHeight, _, _⟩
  have hArea := (clearCrossSectionAreas_positive apparatus.measurements hGeometry).1
  simp only [coordinateInSI_self, confinedAirVolume]
  simpa only [coordinateInSI_self] using mul_pos hArea hHeight

/-! ## Air inventory as a governing solution -/

/-- Ambient density, air molar mass, and the amount-to-molecule factor. -/
structure AirMaterialData where
  ambientMassDensity : MassDensity
  airMolarMass : MolarMass
  amountToMoleculeFactor : InverseAmount

/-- Physical positivity of all three air material inputs. -/
def PositiveAirMaterialData (material : AirMaterialData) : Prop :=
  0 < coordinateInSI SIUnitChoices.SI material.ambientMassDensity ∧
    0 < coordinateInSI SIUnitChoices.SI material.airMolarMass ∧
    0 < coordinateInSI SIUnitChoices.SI material.amountToMoleculeFactor

/-- The three fixed source values supplied for Part A air. -/
def SatisfiesStatedAirData (material : AirMaterialData) : Prop :=
  material.ambientMassDensity = massDensityInKilogramsPerCubicMetre 1.12 ∧
    material.airMolarMass = molarMassInGramsPerMole 28.96 ∧
    material.amountToMoleculeFactor = inverseAmountInPerMole (6.022 * 10 ^ 23)

/-- A candidate mass, amount of substance, and molecule count for the confined air. -/
@[ext]
structure AirInventory where
  mass : Mass
  amount : AmountOfSubstance
  moleculeCount : MoleculeCount

/--
The answer-free governing predicate for the confined-air inventory.  Every
component is positive, and the three coordinate equations retain the complete
density, molar-mass, and molecule-conversion chain.
-/
def AirInventorySolution (apparatus : ApparatusData) (material : AirMaterialData)
    (inventory : AirInventory) : Prop :=
  0 < coordinateInSI SIUnitChoices.SI inventory.mass ∧
    0 < coordinateInSI SIUnitChoices.SI inventory.amount ∧
    0 < coordinateInSI SIUnitChoices.SI inventory.moleculeCount ∧
    coordinateInSI SIUnitChoices.SI inventory.mass =
      coordinateInSI SIUnitChoices.SI material.ambientMassDensity *
        coordinateInSI SIUnitChoices.SI (confinedAirVolume apparatus) ∧
    coordinateInSI SIUnitChoices.SI inventory.amount *
        coordinateInSI SIUnitChoices.SI material.airMolarMass =
      coordinateInSI SIUnitChoices.SI inventory.mass ∧
    coordinateInSI SIUnitChoices.SI inventory.moleculeCount =
      coordinateInSI SIUnitChoices.SI inventory.amount *
        coordinateInSI SIUnitChoices.SI material.amountToMoleculeFactor

/-- A prepared apparatus and positive material data determine exactly one inventory. -/
theorem existsUnique_airInventorySolution (apparatus : ApparatusData)
    (material : AirMaterialData) (hPrepared : PreparedPartAApparatus apparatus)
    (hMaterial : PositiveAirMaterialData material) :
    ∃! inventory, AirInventorySolution apparatus material inventory := by
  let massCoordinate : ℝ :=
    coordinateInSI SIUnitChoices.SI material.ambientMassDensity *
      coordinateInSI SIUnitChoices.SI (confinedAirVolume apparatus)
  let amountCoordinate : ℝ :=
    massCoordinate / coordinateInSI SIUnitChoices.SI material.airMolarMass
  let moleculeCoordinate : ℝ :=
    amountCoordinate *
      coordinateInSI SIUnitChoices.SI material.amountToMoleculeFactor
  let inventory : AirInventory :=
    { mass := ⟨massCoordinate⟩
      amount := ⟨amountCoordinate⟩
      moleculeCount := ⟨moleculeCoordinate⟩ }
  rcases hMaterial with ⟨hDensity, hMolarMass, hFactor⟩
  have hVolume := confinedAirVolume_positive apparatus hPrepared
  have hMass : 0 < massCoordinate := by
    dsimp [massCoordinate]
    positivity
  have hAmount : 0 < amountCoordinate := by
    dsimp [amountCoordinate]
    positivity
  have hMolecules : 0 < moleculeCoordinate := by
    dsimp [moleculeCoordinate]
    positivity
  have hInventory : AirInventorySolution apparatus material inventory := by
    simp only [AirInventorySolution, coordinateInSI_self]
    refine ⟨hMass, hAmount, hMolecules, ?_, ?_, ?_⟩
    · dsimp [inventory, massCoordinate]
      simp only [coordinateInSI_self]
    · dsimp [inventory, amountCoordinate]
      simp only [coordinateInSI_self]
      have hMolarMassNe : material.airMolarMass.val ≠ 0 := by
        simpa only [coordinateInSI_self] using ne_of_gt hMolarMass
      field_simp [hMolarMassNe]
    · dsimp [inventory, moleculeCoordinate]
      simp only [coordinateInSI_self]
  refine ⟨inventory, hInventory, ?_⟩
  intro other hOther
  rcases hInventory with ⟨_, _, _, hInventoryMass, hInventoryAmount, hInventoryCount⟩
  rcases hOther with ⟨_, _, _, hOtherMass, hOtherAmount, hOtherCount⟩
  have hMassCoordinate :
      coordinateInSI SIUnitChoices.SI other.mass =
        coordinateInSI SIUnitChoices.SI inventory.mass :=
    hOtherMass.trans hInventoryMass.symm
  have hAmountProduct :
      coordinateInSI SIUnitChoices.SI other.amount *
          coordinateInSI SIUnitChoices.SI material.airMolarMass =
        coordinateInSI SIUnitChoices.SI inventory.amount *
          coordinateInSI SIUnitChoices.SI material.airMolarMass := by
    calc
      coordinateInSI SIUnitChoices.SI other.amount *
            coordinateInSI SIUnitChoices.SI material.airMolarMass =
          coordinateInSI SIUnitChoices.SI other.mass := hOtherAmount
      _ = coordinateInSI SIUnitChoices.SI inventory.mass := hMassCoordinate
      _ = coordinateInSI SIUnitChoices.SI inventory.amount *
            coordinateInSI SIUnitChoices.SI material.airMolarMass := hInventoryAmount.symm
  have hAmountCoordinate :
      coordinateInSI SIUnitChoices.SI other.amount =
        coordinateInSI SIUnitChoices.SI inventory.amount := by
    exact mul_right_cancel₀ (ne_of_gt hMolarMass) hAmountProduct
  have hCountCoordinate :
      coordinateInSI SIUnitChoices.SI other.moleculeCount =
        coordinateInSI SIUnitChoices.SI inventory.moleculeCount := by
    calc
      coordinateInSI SIUnitChoices.SI other.moleculeCount =
          coordinateInSI SIUnitChoices.SI other.amount *
            coordinateInSI SIUnitChoices.SI material.amountToMoleculeFactor := hOtherCount
      _ = coordinateInSI SIUnitChoices.SI inventory.amount *
            coordinateInSI SIUnitChoices.SI material.amountToMoleculeFactor := by
          rw [hAmountCoordinate]
      _ = coordinateInSI SIUnitChoices.SI inventory.moleculeCount := hInventoryCount.symm
  apply AirInventory.ext
  · exact (coordinateInSI_eq_iff SIUnitChoices.SI other.mass inventory.mass).mp
      hMassCoordinate
  · exact (coordinateInSI_eq_iff SIUnitChoices.SI other.amount inventory.amount).mp
      hAmountCoordinate
  · exact
      (coordinateInSI_eq_iff SIUnitChoices.SI other.moleculeCount inventory.moleculeCount).mp
        hCountCoordinate

/-! ## Isochoric true states and provenanced observations -/

/-- Discrete preparation and operating conditions for the Part A procedure. -/
structure PartAProcedureState where
  valveDClosed : Bool
  valveEClosed : Bool
  outerCylinderFilledNearTop : Bool
  heaterOn : Bool
  homogenizingPumpOn : Bool

/-- A true confined-gas state, separate from every sensor readout. -/
structure GasState where
  temperature : Temperature
  pressure : Pressure
  volume : Volume

/-- One externally supplied simultaneous temperature-pressure observation. -/
structure PressureTemperatureObservation where
  observedTemperature : Temperature
  observedPressure : Pressure

/-- One fixed pair of temperature and pressure response functions. -/
structure SensorModel where
  temperatureResponse : Temperature → Temperature
  pressureResponse : Pressure → Pressure

/-- Optional ideal-calibration condition for a Part A sensor model. -/
def SensorsCalibrated (sensors : SensorModel) : Prop :=
  (∀ temperature, sensors.temperatureResponse temperature = temperature) ∧
    ∀ pressure, sensors.pressureResponse pressure = pressure

/-- Provenance of a simultaneous observation as a fixed-sensor readout of a true state. -/
def SensorReadout (sensors : SensorModel) (state : GasState)
    (observation : PressureTemperatureObservation) : Prop :=
  observation.observedTemperature = sensors.temperatureResponse state.temperature ∧
    observation.observedPressure = sensors.pressureResponse state.pressure

/-- One named isochoric run with fixed apparatus, inventory, sensors, and true states. -/
structure IsochoricGasRun where
  apparatus : ApparatusData
  material : AirMaterialData
  inventory : AirInventory
  molarGasConstant : MolarGasConstant
  procedure : PartAProcedureState
  sensors : SensorModel
  trueStates : ℕ → GasState

/-- Physical preparation of a Part A run; sensor calibration is deliberately absent. -/
def PreparedIsochoricRun (run : IsochoricGasRun) : Prop :=
  PreparedPartAApparatus run.apparatus ∧
    SatisfiesStatedAirData run.material ∧
    PositiveAirMaterialData run.material ∧
    AirInventorySolution run.apparatus run.material run.inventory ∧
    0 < coordinateInSI SIUnitChoices.SI run.molarGasConstant ∧
    run.procedure.valveDClosed = true ∧
    run.procedure.valveEClosed = true ∧
    run.procedure.outerCylinderFilledNearTop = true ∧
    run.procedure.heaterOn = true ∧
    run.procedure.homogenizingPumpOn = true

/-- Positive, isochoric true state obeying the fixed-inventory ideal-gas equation. -/
def TrueIsochoricIdealGasState (run : IsochoricGasRun) (state : GasState) : Prop :=
  0 < coordinateInSI SIUnitChoices.SI state.temperature ∧
    0 < coordinateInSI SIUnitChoices.SI state.pressure ∧
    state.volume = confinedAirVolume run.apparatus ∧
    coordinateInSI SIUnitChoices.SI state.pressure *
        coordinateInSI SIUnitChoices.SI state.volume =
      coordinateInSI SIUnitChoices.SI run.inventory.amount *
        coordinateInSI SIUnitChoices.SI run.molarGasConstant *
        coordinateInSI SIUnitChoices.SI state.temperature

/-- Provenance for one indexed gas observation in a named run. -/
def GasObservationProvenance (run : IsochoricGasRun) (index : ℕ)
    (observation : PressureTemperatureObservation) : Prop :=
  TrueIsochoricIdealGasState run (run.trueStates index) ∧
    SensorReadout run.sensors (run.trueStates index) observation

/--
A finite nonempty pressure-temperature series retaining occurrence order and
multiplicity, with external provenance at every `Fin q` index.
-/
abbrev PressureTemperatureSeries (q : ℕ) :=
  ObservationSeries q IsochoricGasRun PressureTemperatureObservation
    (fun run index observation ↦
      GasObservationProvenance run index.val observation)

end Ipho2026Gpt56solBlind.Shared.Figure17Apparatus
